dnl Process this file with autoconf to produce a configure script.
AC_INIT(README)

dnl Set various version strings - taken gratefully from the GTk sources

# Making releases:
#   MICRO_VERSION += 1;
#   INTERFACE_AGE += 1;
#   BINARY_AGE += 1;
# if any functions have been added, set INTERFACE_AGE to 0.
# if backwards compatibility has been broken,
# set BINARY_AGE and INTERFACE_AGE to 0.

MAJOR_VERSION=1
MINOR_VERSION=1
MICRO_VERSION=2
INTERFACE_AGE=0
BINARY_AGE=0
VERSION=$MAJOR_VERSION.$MINOR_VERSION.$MICRO_VERSION

AC_SUBST(MAJOR_VERSION)
AC_SUBST(MINOR_VERSION)
AC_SUBST(MICRO_VERSION)
AC_SUBST(INTERFACE_AGE)
AC_SUBST(BINARY_AGE)
AC_SUBST(VERSION)

# libtool versioning
LT_RELEASE=$MAJOR_VERSION.$MINOR_VERSION
LT_CURRENT=`expr $MICRO_VERSION - $INTERFACE_AGE`
LT_REVISION=$INTERFACE_AGE
LT_AGE=`expr $BINARY_AGE - $INTERFACE_AGE`

AC_SUBST(LT_RELEASE)
AC_SUBST(LT_CURRENT)
AC_SUBST(LT_REVISION)
AC_SUBST(LT_AGE)

dnl Setup for automake
AM_INIT_AUTOMAKE(midas, $VERSION)

dnl Check for tools

AC_PROG_MAKE_SET
AC_PROG_CC
AM_PROG_LIBTOOL
AC_PROG_INSTALL

dnl The alpha architecture needs special flags for binary portability
AC_CANONICAL_TARGET
case "$target" in
    alpha*-*-linux*)
        CFLAGS="$CFLAGS -mcpu=ev4 -Wa,-mall"
        ;;
esac

dnl BeOS installs the goods in the gnupro directory by default
case "$target" in
    *-*-beos*)
        ac_default_prefix=/boot/develop/tools/gnupro
        ;;
esac

# We pack all structures tightly
CFLAGS="$CFLAGS -fpack-struct"

dnl Check for SDL
SDL_VERSION=1.0.6
AM_PATH_SDL($SDL_VERSION,
            :,
	    AC_MSG_ERROR([*** SDL version $SDL_VERSION not found!])
)
CFLAGS="$CFLAGS $SDL_CFLAGS"
LIBS="$LIBS $SDL_LIBS"

dnl Check for NASM (for assembly blit routines)
AC_ARG_ENABLE(nasm,
[  --enable-nasm           use nasm assembly blitters on x86 [default=yes]],
              , enable_nasm=yes)
if test x$enable_nasm = xyes; then
    AC_PATH_PROG(NASM, nasm)
    if test x$NASM = x -o x$NASM = x'"$NASM"'; then
        : # nasm isn't installed
    else
        have_nasm=yes
        CFLAGS="$CFLAGS -DHAVE_NASM"
        case $target in
          *win32)
              NASMFLAGS="-f win32"
              ;;
          *)
              NASMFLAGS="-f elf -DM_TARGET_ELF"
              ;;
        esac
        AC_SUBST(NASMFLAGS)
    fi
fi
AM_CONDITIONAL(HAVE_NASM, test x$have_nasm = xyes)

dnl Final flags for this build of the mixer
CFLAGS="$CFLAGS -D__SDL__ -DM_TRACKER"

# Finally create all the generated files
AC_OUTPUT([
Makefile
midas.spec
])
