#include "midpres.h"

12 BITMAP "tbar.bmp"

MAINMENU MENU

BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", MENU_FILE_OPEN
        MENUITEM "&Close", MENU_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Change &Directory...", MENU_FILE_CHDIR
        MENUITEM "Add files to &Playlist...", MENU_FILE_PLAYLIST
        MENUITEM SEPARATOR
        MENUITEM "&Save Playlist...", MENU_FILE_PLAYLIST_SAVE
        MENUITEM "Open Playlist...", MENU_FILE_PLAYLIST_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit", MENU_FILE_EXIT
    END

    POPUP "&Playing"
    BEGIN
        MENUITEM "&Next Position\tCtrl+.", MENU_PLAYING_NEXTPOSITION
        MENUITEM "&Prev. Position\tCtrl+,", MENU_PLAYING_PREVPOSITION
        MENUITEM "&Center Channels\tCtrl-E", MENU_PLAYING_CENTERCHANNELS
        MENUITEM "&List Instruments", MENU_PLAYING_LIST_INSTRUMENTS
        MENUITEM "&Filter\tCtrl-F", MENU_PLAYING_FILTER
    END

    POPUP "&Options"
    BEGIN
        MENUITEM "&Preferences", MENU_OPTIONS_PREFERENCES
        MENUITEM "&Sound Options", MENU_OPTIONS_SOUND
        MENUITEM SEPARATOR
        MENUITEM "S&ave Window Arrangement", MENU_OPTIONS_SAVE_WIN
        MENUITEM "&Restore Window Arrangement", MENU_OPTIONS_RESTORE_WIN
    END

    POPUP "&Views"
    BEGIN
        MENUITEM "&Song Information", MENU_VIEWS_SONGINFO
        MENUITEM "&Instrument List", MENU_VIEWS_INSTLIST
        MENUITEM "&Echo Effects",               MENU_VIEWS_ECHOEFFECTS
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&About", MENU_HELP_ABOUT
    END
END



SOUNDOPTIONS DIALOG 91, 89, 142, 87
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | 0xC4
CAPTION "Sound Options"
FONT 8, "MS Sans Serif"
BEGIN
	CONTROL "", SOUNDOPTIONS_MIXRATE, "COMBOBOX", CBS_DROPDOWN | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 52, 4, 46, 51
	CONTROL "Stereo", SOUNDOPTIONS_STEREO, "BUTTON", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 4, 22, 37, 12
	CONTROL "8-bit", SOUNDOPTIONS_8BIT, "BUTTON", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 4, 38, 28, 12
    CONTROL         "Oversampling",SOUNDOPTIONS_OVERSAMPLING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,4,54,82,12
	EDITTEXT SOUNDOPTIONS_BUFFERSIZE, 52, 54, 46, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	EDITTEXT SOUNDOPTIONS_BUFFERBLOCKS, 52, 70, 46, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	DEFPUSHBUTTON "OK", IDOK, 104, 4, 33, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 104, 22, 33, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	LTEXT "Buffer Size:", -1, 4, 54, 39, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Buffer Blocks:", -1, 4, 70, 47, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Mixing Rate:", -1, 4, 4, 43, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
END

SONGINFO DIALOG 27, 33, 200, 54
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | 0xC4
CAPTION "Song Information"
FONT 8, "MS Sans Serif"
BEGIN
	LTEXT "Song:", -1, 4, 4, 23, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	LTEXT "Composer:", -1, 4, 20, 35, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", SONGINFO_SONG, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 44, 3, 106, 12
	CONTROL "", SONGINFO_COMPOSER, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 44, 20, 106, 12
	LTEXT "Comment:", -1, 4, 36, 34, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", SONGINFO_COMMENT, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 44, 36, 106, 12
	PUSHBUTTON "Close", IDCANCEL, 164, 4, 32, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "Save", SONGINFO_SAVE, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_TABSTOP, 164, 22, 32, 14
END

PREFERENCES DIALOG 48, 75, 256, 126
EXSTYLE WS_EX_DLGMODALFRAME
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences"
FONT 8, "MS Sans Serif"
{
 CONTROL "", PREFERENCES_DEFAULTDIR, "EDIT", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 64,4,128,12
 CONTROL "Open views as child windows", PREFERENCES_VIEWSCHILDREN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 4, 82, 154, 12
 CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 208,4,36,14
 CONTROL "Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 208,22,36,14
 CONTROL "Default Directory:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 4,4,56,8
 CONTROL "Unzip Directory:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 4,22,56,8
 CONTROL "", PREFERENCES_UNZIPDIR, "EDIT", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 64,22,128,12
 CONTROL "Default Stereo Separation:", -1, "STATIC", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 4, 64, 88, 8
 CONTROL "", PREFERENCES_DEFAULTSTEREOSEPARATION, "EDIT", ES_LEFT | ES_NUMBER | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 96, 64, 32, 12
 CONTROL "Run UnZip minimized", PREFERENCES_UNZIPMINI, "button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 4, 100, 154, 12, 0
 CONTROL "", PREFERENCES_DEFPLIST, "edit", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 64, 40, 128, 12, 0
 CONTROL "Default Playlist:", -1, "static", SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP, 4, 40, 56, 8, 0
}

ECHOEDITOR DIALOG DISCARDABLE  33, 18, 232, 221
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION |
