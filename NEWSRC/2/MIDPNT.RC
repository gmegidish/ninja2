	DEFPUSHBUTTON "OK", IDOK, 211, 4, 33, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", IDCANCEL, 211, 22, 33, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	RTEXT "Default Directory:", -1, 4, 4, 56, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	RTEXT "Unzip Directory:", -1, 4, 22, 56, 8, SS_RIGHT | WS_CHILD | WS_VISIBLE | WS_GROUP
	EDITTEXT PREFERENCES_UNZIPDIR, 64, 22, 128, 12, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
END

