    GROUPBOX        "Echoes",ECHOEDITOR_ECHOESGROUP,8,80,160,132
    RTEXT           "Gain:",ECHOEDITOR_TOTALGAINTEXT,100,36,22,8
    LTEXT           "Filter",ECHOEDITOR_FILTERTEXT,124,92,16,8
